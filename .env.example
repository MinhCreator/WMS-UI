# Frontend configuration for warehouseos-ui.

# API origin. Leave empty to use same-origin /api (recommended: Vite proxies
# to the backend in dev, and production serves both from one origin).
VITE_API_URL=

# `vite dev` proxy target for /api when VITE_API_URL is empty.
VITE_DEV_API_TARGET=http://localhost:3000

# Screens that still render sample data show a "demo" badge. Set to "false"
# once every screen is wired to the API.
VITE_DEMO_DATA=true
